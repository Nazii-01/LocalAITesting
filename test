#include <stdio.h>

int main() {
    int num1, num2, sum;
    
    // Prompt the user for input
    printf("Enter two integers: ");
    
    // Read two integers from the console
    scanf("%d %d", &num1, &num2);
    
    // Calculate the sum
    sum = num1 + num2;
    
    // Display the result
    printf("%d + %d = %d\n", num1, num2, sum);
    
    return 0;
}
